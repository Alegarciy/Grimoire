      "isDeleted": false,
      "boundElements": [],
      "updated": 1775926285584,
      "link": null,
      "locked": false,
      "text": "We say that estimator y (y_hat) will\nfollow a Gaussian distribution\nbecause of the noise (epsilon)\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "AaRBnPmjG_k-FXE7jR_2Q",
      "originalText": "We say that estimator y (y_hat) will follow a Gaussian distribution because of the noise (epsilon)\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
