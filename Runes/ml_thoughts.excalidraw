      ],
      "updated": 1775926211702,
      "link": null,
      "locked": false,
      "text": "Now that f(x_i,w) has a mathematical \nformal definition we can make use\nof linear regression / logistic regression",
      "fontSize": 13.989580423192276,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Now that f(x_i,w) has a mathematical \nformal definition we can make use\nof linear regression / logistic regression",
      "autoResize": true,
      "lineHeight": 1.25
    },
